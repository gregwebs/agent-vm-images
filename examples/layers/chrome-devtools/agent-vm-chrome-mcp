#!/bin/bash
set -euo pipefail

import_ca() {
    local home=$1 ca=/usr/local/share/ca-certificates/microsandbox-ca.crt
    mkdir -p "$home/.pki/nssdb" || { echo "agent-vm-chrome-mcp: warning: failed to initialize NSS DB" >&2; return; }
    [ -f "$home/.pki/nssdb/cert9.db" ] || certutil -d "sql:$home/.pki/nssdb" -N --empty-password \
        || { echo "agent-vm-chrome-mcp: warning: failed to initialize NSS DB (HTTPS may fail ERR_CERT_AUTHORITY_INVALID)" >&2; return; }
    [ ! -f "$ca" ] || certutil -d "sql:$home/.pki/nssdb" -A -t C,, -n microsandbox -i "$ca" \
        || echo "agent-vm-chrome-mcp: warning: failed to import microsandbox CA (HTTPS may fail ERR_CERT_AUTHORITY_INVALID)" >&2
}

MCP_PREFIX=/opt/agent-vm/chrome-devtools-mcp
MCP_BIN=$MCP_PREFIX/node_modules/.bin/chrome-devtools-mcp
# One canonical exact semver (images/tools/opencode/plugins/prepare-lock.sh:19).
SEMVER='^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(\+[0-9A-Za-z-]+(\.[0-9A-Za-z-]+)*)?$'
# The image preinstalls the reviewed selection (#41): first use must never
# resolve or fetch a package. agent-vm launches
# `npx -y chrome-devtools-mcp@VERSION ...`, so exactly that spelling maps to the
# installed file; other direct package-manager commands are refused. Commands
# that start a manager indirectly are the caller's own (user-requested installs
# are outside the image's guarantee).
refuse() {
    echo "agent-vm-chrome-mcp: $1; refusing to run a package manager (chrome-devtools-mcp is preinstalled in $MCP_PREFIX)" >&2
    exit 2
}
installed_version() {
    local version
    version=$(jq -er '.version | strings' "$MCP_PREFIX/node_modules/chrome-devtools-mcp/package.json") ||
        { echo 'agent-vm-chrome-mcp: cannot read the installed chrome-devtools-mcp version' >&2; exit 1; }
    if ! printf '%s' "$version" | grep -Eqx "$SEMVER"; then
        echo 'agent-vm-chrome-mcp: cannot read the installed chrome-devtools-mcp version' >&2
        exit 1
    fi
    printf '%s\n' "$version"
}
[ "$#" -gt 0 ] || { echo 'usage: agent-vm-chrome-mcp COMMAND [ARG ...]' >&2; exit 2; }
case "$1" in -*) echo "agent-vm-chrome-mcp: command must not start with '-': $1" >&2; exit 2 ;; esac
case "$1" in
    npx)
        installed=$(installed_version) || exit 1
        [ "$#" -ge 3 ] && [ "$2" = -y ] && [ "$3" = "chrome-devtools-mcp@$installed" ] ||
            refuse "'${*:1:3}' does not name the installed chrome-devtools-mcp@$installed"
        shift 3
        set -- "$MCP_BIN" "$@"
        ;;
    chrome-devtools-mcp) shift; set -- "$MCP_BIN" "$@" ;;
esac
case "${1##*/}" in
    npx | npm | pnpm | pnx | pnpx | corepack | yarn | yarnpkg | bun | bunx) refuse "$1 is a package manager" ;;
esac

if [ "$(id -u)" = 0 ]; then
    cd /home/chrome || { echo "agent-vm-chrome-mcp: cannot cd to /home/chrome" >&2; exit 1; }
    if ! sudo -u chrome -n -- bash -c "$(declare -f import_ca); import_ca /home/chrome"; then
        echo "agent-vm-chrome-mcp: warning: failed to prepare chrome NSS DB (HTTPS may fail ERR_CERT_AUTHORITY_INVALID)" >&2
    fi
    exec sudo -u chrome -H -n \
        --preserve-env=NODE_EXTRA_CA_CERTS,SSL_CERT_FILE,CURL_CA_BUNDLE,REQUESTS_CA_BUNDLE \
        --preserve-env=PATH,HTTP_PROXY,HTTPS_PROXY,NO_PROXY,http_proxy,https_proxy,no_proxy \
        --preserve-env=CHROME_DEVTOOLS_MCP_NO_USAGE_STATISTICS,CI,DEBUG \
        --preserve-env=TZ,LANG,LC_ALL,TMPDIR -- "$@"
fi
cd "$HOME" || { echo "agent-vm-chrome-mcp: cannot cd to HOME" >&2; exit 1; }
import_ca "$HOME"
exec "$@"
