
# agent-vm interactive defaults: the guest HOME is the caller's mount, so the
# settings every session of this image shares live here, under /etc, and a
# user-owned ~/.zshrc is still read after this file.
export SHELL=/bin/zsh
PROMPT='%F{green}%~%f %# '

# History: shared rather than overwritten (several panes share one file), with
# the same ignore/erasedups behavior as the bash defaults above.
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt SHARE_HISTORY HIST_IGNORE_ALL_DUPS HIST_IGNORE_SPACE

# Completion definitions, including zsh's own git, ssh and package ones.
autoload -Uz compinit && compinit
